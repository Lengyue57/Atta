      },
      {
        "id": "lattice",
        "graph": {
          "units": "mm",
          "features": [
            {
              "id": "cell",
              "op": "field_tree",
              "args": {
                "tree": {
                  "op": "intersection",
                  "children": [
                    {
                      "op": "box",
                      "size": [
                        20,
                        20,
                        8
                      ]
                    },
                    {
                      "op": "gyroid",
                      "period": 8,
                      "band": 0.35
                    }
                  ]
                },
                "bounds": [
                  [
                    -13,
                    -13,
                    -7
                  ],
                  [
                    13,
                    13,
                    7
                  ]
