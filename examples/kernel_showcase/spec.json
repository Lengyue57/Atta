{
  "schema": "atta.spec/v3",
  "name": "kernel_showcase",
  "material": "steel",
  "model": {
    "kind": "assembly",
    "parts": [
      {
        "id": "base",
        "fixed": true,
        "graph": {
          "units": "mm",
