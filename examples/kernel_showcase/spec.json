                  [
                    [
                      40,
                      0,
                      0
                    ],
                    [
                      40,
                      30,
                      0
                    ]
                  ]
                ],
                "tolerance": 0.05,
                "fail_on_tolerance": true
              }
            },
            {
              "id": "solid",
              "op": "thicken",
              "inputs": [
                "skin"
              ],
              "args": {
                "thickness": 2
              }
            }
          ]
        },
        "ports": [
          {
            "name": "in",
            "origin_mm": [
              20,
              15,
              0
            ],
            "axis": [
              0,
              0,
              1
            ],
            "x_axis": [
              1,
              0,
              0
            ]
          },
          {
            "name": "out",
            "origin_mm": [
              20,
              15,
              2
