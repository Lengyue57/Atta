          "units": "mm",
          "features": [
            {
              "id": "skin",
              "op": "nurbs_surface",
              "args": {
                "control_points": [
                  [
                    [
                      0,
                      0,
                      0
                    ],
                    [
                      0,
                      30,
                      0
                    ]
