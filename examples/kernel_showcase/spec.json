            {
              "id": "body",
              "op": "box",
              "args": {
                "size": [
                  60,
                  40,
                  10
                ]
              }
            },
            {
              "id": "round",
              "op": "fillet",
              "inputs": [
                "body"
              ],
              "args": {
                "radius": 3,
                "edges": {
                  "parallel": "z",
                  "kind": "line",
                  "expect_count": 4
                },
                "linear_deflection": 0.05,
                "max_triangles": 200000
              }
            }
          ]
        },
        "ports": [
          {
            "name": "out",
            "origin_mm": [
              0,
              0,
              10
            ],
            "axis": [
              0,
              0,
              1
            ],
            "x_axis": [
              1,
              0,
              0
            ]
          },
          {
            "name": "side",
            "origin_mm": [
              30,
              0,
              10
            ],
            "axis": [
              1,
              0,
              0
            ],
            "x_axis": [
              0,
              1,
              0
            ]
          }
        ]
      },
      {
        "id": "panel",
