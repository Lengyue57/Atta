    "mates": [
      {
        "id": "lock_panel",
        "type": "lock",
        "a": "base",
        "b": "panel",
        "port_a": "out",
        "port_b": "in"
      },
      {
        "id": "lock_cap",
        "type": "lock",
        "a": "panel",
        "b": "cap",
        "port_a": "out",
        "port_b": "in"
      },
      {
        "id": "lock_lattice",
        "type": "lock",
        "a": "base",
        "b": "lattice",
        "port_a": "side",
        "port_b": "in"
      }
