          "units": "mm",
          "features": [
            {
              "id": "block",
              "op": "box",
              "args": {
                "size": [
                  20,
                  10,
                  4
                ]
              }
            },
            {
              "id": "edge",
              "op": "chamfer",
              "inputs": [
                "block"
              ],
              "args": {
                "length": 1,
                "edges": {
                  "parallel": "z",
                  "kind": "line",
                  "expect_count": 4
                }
              }
            }
          ]
        },
        "ports": [
          {
            "name": "in",
            "origin_mm": [
              10,
